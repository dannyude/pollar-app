# Pollar publishable key. Safe to expose in the browser.
# dashboard.pollar.xyz → Build → API Keys → Generate (type: Publishable).
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=pub_testnet_xxxxxxxxxxxxxxxxxxxx

# Puente API. src/api/client.ts appends paths like /agents, so this must end in /api.
# Local backend: http://localhost:8000/api · deployed: https://<your-api-host>/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
