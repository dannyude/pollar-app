# Copy this file to .env.local and fill in the blank.
# .env.local holds the real value and is git-ignored; this file is the checklist.
#
#   cp .env.example .env.local
#
# On Vercel, set these as environment variables instead.

# Pollar publishable key: dashboard.pollar.xyz → Build → API Keys → Generate (Publishable).
# Looks like pub_testnet_… or pub_mainnet_…. Safe to expose in the browser.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# Puente API. src/api/client.ts appends paths like /agents, so this must end in /api.
#   local backend: http://localhost:8000/api
#   deployed:      https://your-api-host/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# ── Local testing without a Pollar sign-in (optional) ────────────────────────────
# Set a funded testnet G-address here and run the backend with DEV_AUTH=1: the login
# page then signs you in as NEXT_PUBLIC_DEV_USER with an Authorization: Dev header.
# Leave both blank to use the real Pollar sign-in.
NEXT_PUBLIC_DEV_WALLET=
NEXT_PUBLIC_DEV_USER=

# Issuer of the USDC the /send page offers. Defaults to Circle's testnet issuer.
NEXT_PUBLIC_USDC_ISSUER=
