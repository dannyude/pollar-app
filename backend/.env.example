# Copy this file to .env and fill in the three blanks below.
# .env holds the real values and is git-ignored; this file is the checklist.
#
#   cp .env.example .env
#
# On a host (Render, Railway), set these as environment variables instead.

# ── Required ──────────────────────────────────────────────────────────────────

# Postgres connection string.
#   local dev cluster: postgres://puente@localhost:5433/puente
#   Supabase:          the transaction pooler URL (port 6543)
DATABASE_URL=

# Pollar secret key: dashboard.pollar.xyz → Build → API Keys → Generate (Secret).
# Looks like sec_testnet_… or sec_mainnet_…, and must match STELLAR_NETWORK.
# Shown only once. Without it, real sign-ins fail with AUTH_NOT_CONFIGURED.
POLLAR_SECRET_KEY=

# Escrow account secret, a Stellar seed starting with S.
# Create one with: python -m scripts.escrow_setup --write-env
ESCROW_SECRET=

# ── Optional: uncomment only to override the default ──────────────────────────

# Which Stellar network the escrow runs on. Default: testnet
# STELLAR_NETWORK=testnet

# Browser origins allowed to call the API, comma-separated.
# Default: http://localhost:3000 · live: https://your-frontend.vercel.app
# CORS_ORIGINS=http://localhost:3000

# Set to production on a live host: it turns dev auth off. Default: development
# ENVIRONMENT=production

# Local testing only: accept `Authorization: Dev <userId> <G-address>`.
# Ignored when ENVIRONMENT=production.
# DEV_AUTH=1

# Defaults come from app/config.py; USDC_ISSUER and HORIZON_URL follow the network.
# USDC_ISSUER=
# HORIZON_URL=
# CASH_IN_TTL_MINUTES=30
# CASH_OUT_TTL_MINUTES=30
# PAYOUT_WINDOW_MINUTES=120
# AUTO_COMPLETE_HOURS=24
# MAINTENANCE_INTERVAL_SECONDS=15
