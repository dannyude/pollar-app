# Postgres. Local: postgres://USER@localhost:5432/puente
# Supabase: use the transaction pooler connection string (port 6543).
DATABASE_URL=postgres://puente@localhost:5433/puente

# Pollar secret key (dashboard.pollar.xyz → Build → API Keys → Secret).
# Used only to verify the session token the app sends: POST /v1/tokens/verify.
POLLAR_SECRET_KEY=sec_testnet_xxxxxxxxxxxxxxxxxxxx

# Stellar: testnet | mainnet. USDC_ISSUER and HORIZON_URL default to Circle's
# USDC and SDF's Horizon for that network.
STELLAR_NETWORK=testnet
# USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# HORIZON_URL=https://horizon-testnet.stellar.org

# Escrow account secret (S…). Create one: python -m scripts.escrow_setup --write-env
ESCROW_SECRET=

# Browser origins allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Order timing.
# CASH_IN_TTL_MINUTES=30      # add-money order expires if the customer hasn't paid
# CASH_OUT_TTL_MINUTES=30     # cash-out order expires if no USDC arrives (late USDC is still credited)
# PAYOUT_WINDOW_MINUTES=120   # after this, a customer can refund an unpaid cash-out
# AUTO_COMPLETE_HOURS=24      # cash-out completes if the customer never confirms
# MAINTENANCE_INTERVAL_SECONDS=15  # how often those timers are applied (0 = off)

# Local testing only: accept `Authorization: Dev <userId> <G-address>`.
# Never on in production (ignored when ENVIRONMENT=production).
# DEV_AUTH=1
# ENVIRONMENT=development
